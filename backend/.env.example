# Exact frontend origins, separated by commas. Do not use *.
# Example: https://your-frontend.example.com
CORS_ORIGINS=
CROWD_VIDEO_PATH=videos/crowd.mp4
CROWD_CAPACITY=300
CROWD_ZONE_ID=main-gate
CROWD_ZONE_NAME=Main Darshan Gate
MODEL_PATH=yolo11n.pt
MODEL_CONF=0.5
MODEL_IOU=0.45
MODEL_DEVICE=cpu

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Darshan prediction system
# SQLite database file (relative paths are resolved from the backend folder).
DARSHAN_DB_PATH=data/darshan.db
# Capacity of the queue zone, used to derive the crowd level.
DARSHAN_QUEUE_CAPACITY=250
# If set, admin write/retrain endpoints require an X-Admin-Token header.
ADMIN_API_TOKEN=
